[physics]

3d/run_on_separate_thread=true
common/physics_ticks_per_second=45
common/max_physics_steps_per_frame=6
3d/physics_engine="Rapier3D"
jolt_physics_3d/motion_queries/recovery_iterations=10
common/physics_interpolation=true
rapier/queries/max_shape_cast_results=32
rapier/shapes/scale_subdivisions=15

[rendering]

textures/canvas_textures/default_texture_filter=0
gl_compatibility/driver.windows="opengl3_angle"
gl_compatibility/driver.macos="opengl3_angle"
textures/vram_compression/import_etc2_astc=true
textures/decals/filter=0
